{
  "mcpServers": {
    "aws-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@1.5.4"
      ],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_API_MCP_PROFILE_NAME": "${AWS_PROFILE:-default}",
        "REQUIRE_MUTATION_CONSENT": "true",
        "AWS_API_MCP_TELEMETRY": "false"
      }
    },
    "postgres": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "postgres-mcp@0.3.0",
        "--access-mode=restricted"
      ],
      "env": {
        "DATABASE_URI": "${DATABASE_URI:-postgresql://localhost:5432/angus}"
      }
    }
  }
}