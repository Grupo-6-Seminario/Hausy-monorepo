# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Bedrock AgentCore harness to invoke. Account-specific — get this from whoever
# provisioned the harness, or from the AgentCore console.
# Format: arn:aws:bedrock-agentcore:<region>:<account-id>:harness/<name>
AGENTCORE_HARNESS_ARN=

# Optional. Defaults to us-east-1.
AWS_REGION=us-east-1

# Optional. Named AWS profile the aws-mcp server should use. Defaults to "default".
AWS_PROFILE=default

# Local OpenAI-compatible model used by the buyer agent.
# The URL and model have working defaults; set the token required by your local deployment.
LOCAL_LLM_URL=http://127.0.0.1:8000
LOCAL_LLM_TOKEN=
LOCAL_LLM_MODEL=Qwen3.5-9B-4bit

# Local HTTP API consumed by the frontend proxy.
HAUSY_API_ADDR=127.0.0.1:8080

# Optional. Read by the postgres MCP server.
# Defaults to postgresql://localhost:5432/hausy
DATABASE_URI=postgresql://localhost:5432/hausy
