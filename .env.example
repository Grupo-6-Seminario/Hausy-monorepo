# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Bedrock AgentCore harness to invoke. Account-specific — get this from whoever
# provisioned the harness, or from the AgentCore console.
# Format: arn:aws:bedrock-agentcore:<region>:<account-id>:harness/<name>
AGENTCORE_HARNESS_ARN=

# Optional. Defaults to us-east-1.
AWS_REGION=us-east-1

# Optional. Named AWS profile the aws-mcp server should use. Defaults to "default".
AWS_PROFILE=default

# Optional. Read by the postgres MCP server.
# Defaults to postgresql://localhost:5432/angus
DATABASE_URI=postgresql://localhost:5432/angus
