# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Optional. Defaults to us-east-1.
AWS_REGION=us-east-1

# Your own `aws login` profile (never root). The backend signs Bedrock calls with
# it when HAUSY_LLM=bedrock, and the aws-mcp server uses it. Defaults to "default".
AWS_PROFILE=default

# Model behind the reply writer, the planner's fallback and the no-database chat:
# "local" (default) or "bedrock". Any other value stops the API at startup.
HAUSY_LLM=local

# Used when HAUSY_LLM=bedrock. Defaults to the approved Claude Sonnet 4.6 profile.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Local OpenAI-compatible model, used when HAUSY_LLM=local.
# The URL and model have working defaults; set the token required by your local deployment.
LOCAL_LLM_URL=http://127.0.0.1:8000
LOCAL_LLM_TOKEN=
LOCAL_LLM_MODEL=Qwen3.5-9B-4bit

# Local HTTP API consumed by the frontend proxy.
HAUSY_API_ADDR=127.0.0.1:8080

# Backend JSON log threshold: debug, info (default), warn, or error.
HAUSY_LOG_LEVEL=info

# Optional. Read by the postgres MCP server.
# Defaults to postgresql://hausy:hausy@localhost:5432/hausy
DATABASE_URI=postgresql://hausy:hausy@localhost:5432/hausy

# Optional. "jev" plans each turn with Jev (typesafe-ai/jev on Vercel AI Gateway)
# under a 6 s budget, falling back to the local model. Anything else, or unset,
# plans with the local model only.
HAUSY_PLANNER=

# Needed for HAUSY_PLANNER=jev and for `go run ./cmd/listings eligibility`.
AI_GATEWAY_API_KEY=
